                <component
                  refId="Package\SEQ_Load_Faits\DFT_Load_fait_activites\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    a.id AS source_id,
    CAST(CONVERT(VARCHAR(8), a.date_debut, 112) AS INT) AS temps_id,
    dr.region_id,
    da.association_id,
    dm.maison_id,
    a.type_activite,
    a.statut,
    a.budget,
    ISNULL(r.nb_participants, 0) AS nb_participants,
    ISNULL(r.taux_satisfaction, 0) AS taux_satisfaction,
    ISNULL(r.budget_consomme, 0) AS budget_consomme,
    DATEDIFF(DAY, a.date_debut, a.date_fin) AS duree_jours
FROM dbo.stg_jam3iya_activite a
LEFT JOIN dbo.stg_jam3iya_rapport_activite r ON a.id = r.activite_id
INNER JOIN DWH_MJCC.dbo.dim_association da ON a.association_id = da.source_id
INNER JOIN DWH_MJCC.dbo.dim_maison_jeunes dm ON a.maison_jeunes_id = dm.source_id
INNER JOIN dbo.stg_jam3iya_maison_jeunes m_stg ON a.maison_jeunes_id = m_stg.id
INNER JOIN DWH_MJCC.dbo.dim_region dr ON m_stg.ville = dr.ville AND m_stg.region = dr.region</property>
