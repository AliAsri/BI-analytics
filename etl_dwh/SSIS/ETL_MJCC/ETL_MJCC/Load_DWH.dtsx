                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    o.id AS source_id,
    CAST(CONVERT(VARCHAR(8), o.date_operation, 112) AS INT) AS temps_id,
    db.beneficiaire_id,
    do.offre_id,
    ISNULL(dr.region_id, (SELECT TOP 1 region_id FROM DWH_MJCC.dbo.dim_region)) AS region_id,
    o.montant_reduction,
    1 AS nb_operations
FROM dbo.stg_passjeunes_operation o
INNER JOIN DWH_MJCC.dbo.dim_beneficiaire db ON o.beneficiaire_id = db.source_id
INNER JOIN DWH_MJCC.dbo.dim_offre do ON o.offre_id = do.source_id
LEFT JOIN DWH_MJCC.dbo.dim_region dr ON o.ville = dr.ville</property>
