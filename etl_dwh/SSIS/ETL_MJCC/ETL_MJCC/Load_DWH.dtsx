                <component
                  refId="Package\SEQ_Load_Dimensions\DFT_Load_dim_region\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT 
    ville, 
    region,
    CAST(CASE 
        WHEN region LIKE 'Tanger%' THEN N'Nord'
        WHEN region LIKE 'Oriental%' THEN N'Nord-Est'
        WHEN region LIKE 'Fes%' OR region LIKE 'Fès%' THEN N'Centre-Nord'
        WHEN region LIKE 'Rabat%' THEN N'Nord-Ouest'
        WHEN region LIKE 'Beni%' OR region LIKE 'Béni%' THEN N'Centre'
        WHEN region LIKE 'Casablanca%' THEN N'Centre-Ouest'
        WHEN region LIKE 'Marrakech%' THEN N'Centre-Ouest'
        WHEN region LIKE 'Souss%' THEN N'Sud-Ouest'
        WHEN region LIKE 'Draa%' OR region LIKE 'Drâa%' THEN N'Sud-Est'
        WHEN region LIKE 'Guelmim%' THEN N'Sud'
        WHEN region LIKE 'Laayoune%' OR region LIKE 'Laâyoune%' THEN N'Sahara'
        WHEN region LIKE 'Dakhla%' THEN N'Sahara'
        ELSE N'Autre'
    END AS NVARCHAR(50)) AS zone_geo
FROM (
    SELECT ville, region FROM dbo.stg_passjeunes_beneficiaire WHERE ville IS NOT NULL AND ville &lt;&gt; ''
    UNION
    SELECT ville, region FROM dbo.stg_passjeunes_offre WHERE ville IS NOT NULL AND ville &lt;&gt; ''
    UNION
    SELECT ville, region FROM dbo.stg_jam3iya_maison_jeunes WHERE ville IS NOT NULL AND ville &lt;&gt; ''
    UNION
    SELECT ville, region FROM dbo.stg_jam3iya_colonie_vacances WHERE ville IS NOT NULL AND ville &lt;&gt; ''
) AS r</property>
