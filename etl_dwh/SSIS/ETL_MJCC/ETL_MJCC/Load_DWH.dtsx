                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    s.id AS source_id,
    CAST(CONVERT(VARCHAR(8), s.date_renouvellement, 112) AS INT) AS temps_id,
    db.beneficiaire_id,
    do.offre_id,
    s.annee,
    s.credit_initial,
    s.credit_restant
FROM dbo.stg_passjeunes_solde s
INNER JOIN DWH_MJCC.dbo.dim_beneficiaire db ON s.beneficiaire_id = db.source_id
INNER JOIN DWH_MJCC.dbo.dim_offre do ON s.offre_id = do.source_id</property>
